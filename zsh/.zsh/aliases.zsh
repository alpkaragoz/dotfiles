# ── Filesystem ───────────────────────────────────────────────
alias ls='ls --color=auto'
alias ll='ls -alFh'
alias la='ls -A'
alias l='ls -CF'
alias lt='ls -lAFht'                    # newest first
alias grep='grep --color=auto'
alias diff='diff --color=auto'
alias df='df -h'
alias du='du -h'
alias free='free -h'

# ── Git ──────────────────────────────────────────────────────
alias g='git'
alias gs='git status'
alias ga='git add'
alias gaa='git add --all'
alias gc='git commit'
alias gcm='git commit -m'
alias gca='git commit --amend'
alias gp='git push'
alias gpf='git push --force-with-lease'
alias gpl='git pull'
alias gf='git fetch --all --prune'
alias gd='git diff'
alias gds='git diff --staged'
alias gl='git log --oneline --graph --decorate -20'
alias gla='git log --oneline --graph --decorate --all -30'
alias gb='git branch'
alias gba='git branch -a'
alias gco='git checkout'
alias gsw='git switch'
alias gsc='git switch -c'
alias gm='git merge'
alias grb='git rebase'
alias gst='git stash'
alias gstp='git stash pop'
alias gcp='git cherry-pick'
alias gbl='git blame'
alias grt='cd $(git rev-parse --show-toplevel 2>/dev/null || echo .)'

# ── Maven ────────────────────────────────────────────────────
alias mvnc='mvn clean'
alias mvni='mvn clean install'
alias mvnis='mvn clean install -DskipTests'
alias mvnt='mvn clean test'
alias mvnp='mvn clean package'
alias mvnps='mvn clean package -DskipTests'
alias mvnd='mvn dependency:tree'
alias mvnv='mvn versions:display-dependency-updates'

# ── Docker ───────────────────────────────────────────────────
alias dk='docker'
alias dkps='docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"'
alias dkpsa='docker ps -a --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"'
alias dki='docker images --format "table {{.Repository}}\t{{.Tag}}\t{{.Size}}"'
alias dkl='docker logs -f'
alias dke='docker exec -it'
alias dkr='docker run --rm -it'
alias dkc='docker compose'
alias dkcu='docker compose up -d'
alias dkcd='docker compose down'
alias dkcl='docker compose logs -f'
alias dkprune='docker system prune -af --volumes'

# ── Kubectl ──────────────────────────────────────────────────
alias k='kubectl'
alias kgp='kubectl get pods'
alias kgs='kubectl get svc'
alias kgd='kubectl get deployments'
alias kgn='kubectl get nodes'
alias kga='kubectl get all'
alias kgi='kubectl get ingress'
alias kl='kubectl logs -f'
alias kd='kubectl describe'
alias ke='kubectl exec -it'
alias kx='kubectl config get-contexts'
alias kns='kubectl config set-context --current --namespace'
alias kctx='kubectl config use-context'
alias kaf='kubectl apply -f'
alias kdf='kubectl delete -f'
alias kdp='kubectl describe pod'
alias kds='kubectl describe svc'

# ── Misc ─────────────────────────────────────────────────────
alias cls='clear'
alias reload='source ~/.zshrc'
alias path='echo $PATH | tr ":" "\n"'
alias myip='curl -s ifconfig.me && echo'
alias weather='curl -s "wttr.in/?format=3"'
